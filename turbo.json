{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "clean": {
            "cache": false
        },
        "lint": {
            "dependsOn": ["build"]
        },
        "lint:fix": {
            "dependsOn": ["build"]
        },
        "format": {},
        "format:fix": {},
        "check-types": {},
        "test": {
            "dependsOn": ["build"]
        },
        "test:cov": {
            "dependsOn": ["build"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "artifacts/**", "out/**"],
            "inputs": ["$TURBO_DEFAULT$", "src/**/*.ts", "src/**/*.json"]
        },
        "dev": {
            "cache": false
        },
        "start": {
            "dependsOn": ["build"]
        },
        "env:prebuild": {
            "cache": false
        },
        "deploy:v3": {
            "dependsOn": ["build"],
            "outputs": ["deployments/**"]
        },
        "deploy:router": {
            "dependsOn": ["deploy:v3"]
        },
        "deploy:subgraph": {
            "dependsOn": ["deploy:router"]
        },
        "deploy:all": {
            "dependsOn": ["deploy:subgraph"]
        },
        "test:integration": {
            "dependsOn": ["deploy:all"]
        }
    },
    "globalDependencies": [".eslintrc.cjs", ".prettierrc", "**/.env", "tsconfig.json"]
}
